// C:\DataFlex Projects\FutbolWebApp\AppSrc\SelectPosicion.wo
// SelectPosicion
//

Use cWebView.pkg
Use cWebList.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebColumnButton.pkg
Use cWebColumn.pkg
Use cWebHtmlBox.pkg

Use cposicionDataDictionary.dd

Object oSelectPosicion is a cWebView
    Set psCaption to "Posiciones"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtSelect
    Set piColumnCount to 12
    Set pbShowCaption to False
    Set piMaxWidth to 1024
    Set psCSSClass to "SelectView SelectPosicionView"

    // Guardo aqui el jugador cuando llegamos desde ZoomJugador
    Property String psJugadorFilterRowID ""
    Property Integer piJugadorFilterID 0

    Object oposicion_DD is a cposicionDataDictionary
    End_Object 

    Set Main_DD to oposicion_DD
    Set Server  to oposicion_DD


    Object oSelectHeader is a cWebHtmlBox
        // Cabecera visual del listado
        Set piColumnSpan to 0
        Set psCSSClass to "ModuleHeader SelectHeader"
        Set psHtml to '<section class="ModuleHeaderCard"><div><span class="ModuleEyebrow">Campo</span><h1>Posiciones</h1><p>Catalogo de roles tacticos para clasificar y ordenar la plantilla.</p></div><div class="ModuleHeaderBadge">Listado</div></section>'
    End_Object

    // Lista principal de posiciones
    Object oList is a cWebList
        Set piColumnSpan to 0
        Set psCSSClass to "MobileList SelectList ModuleList"
        Set pbServerOnRowClick to True
        Set pbFillHeight to True
        Set pbShowHeader to True
        Set piSortColumn to 0

        Object oposicionNombre is a cWebColumn
            Entry_Item posicion.Nombre
            Set psCaption to "Posicion"
            Set piWidth to 500
        End_Object 

        Object oDetailButton is a cWebColumnButton
            // Boton para abrir la ficha de la posicion
            Set psCaption to "Detalle"
            Set piWidth to 45
            Set pbFixedWidth to True
            Set pbResizable to False
            Set piListRowSpan to 1
            Set psBtnCssClass to "WebButtonIcon WebIcon_Info"
            Set peAlign to alignLeft


            WebRegisterPath ntNavigateForward oZoomPosicion

            Procedure OnClick
                // Abre el zoom desde el boton de detalle
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bReadOnly
            End_Procedure

        End_Object 

        WebRegisterPath ntNavigateForward oZoomPosicion

        Procedure OnRowClick String sRowId
            tWebNavigateData NavigateData
            Get GetNavigateData to NavigateData

            Case Begin
                Case (NavigateData.eNavigateType = nfFromParent)
                    // Si viene desde un padre, abre la posicion seleccionada
                    Send NavigateForward of oZoomPosicion Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromChild)
                    // Si vuelve desde un hijo, cierra el selector
                    Send NavigateClose Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromMain)
                    // Si es una busqueda principal, devuelve el registro elegido
                    Send NavigateClose Self
                    Case Break

                Case Else // nfUndefined
                    // Entrada normal desde el menu o desde ZoomJugador
                    Send NavigateForward of oZoomPosicion Self

            Case End
        End_Procedure

        Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
            Move True to NavigateData.bReadOnly
        End_Procedure

    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSearch is a cWebMenuItem
            Set psCSSClass to "WebPromptMenuItem"
            Set psCaption to "Buscar"

            Procedure OnClick
                // Abre la busqueda de la lista
                Send Search of oList
            End_Procedure

        End_Object 

        Object oNewButton is a cWebMenuItem
            Set psCSSClass to "WebClearMenuItem"
            Set psCaption to "Nueva posicion"


            WebRegisterPath ntNavigateForward oZoomPosicion

            Procedure OnClick
                // Abre el zoom preparado para una posicion nueva
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bNewRecord
            End_Procedure

        End_Object 
    End_Object 

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        String sJugadorID sJugadorRowID

        WebSet pbRender of oNewButton to True
        WebSet pbRender of oDetailButton to True

        Case Begin
            Case (NavigateData.eNavigateType = nfFromParent)
                // Navegacion desde una vista padre
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // Navegacion al volver desde una vista hija
                Case Break

            Case (NavigateData.eNavigateType = nfFromMain)
                // Cuando se usa como busqueda, no hace falta el boton de detalle
                WebSet pbRender of oDetailButton to False
                Case Break

            Case Else // nfUndefined
                // Entrada manual desde ZoomJugador
                Get NamedValueGet NavigateData.NamedValues "JugadorID" to sJugadorID
                Get NamedValueGet NavigateData.NamedValues "JugadorRowID" to sJugadorRowID
                Set piJugadorFilterID to sJugadorID
                Set psJugadorFilterRowID to sJugadorRowID

        Case End

    End_Procedure


End_Object 
