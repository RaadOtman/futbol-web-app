37873>>>        tWebNavigateData NavigateData
37873>>>        tWebNavigateData NavigateData
37873>>>        Boolean bHasRecord
37873>>>        Handle hoDD
37873>>>
37873>>>        Get Server to hoDD
37874>>>        Get GetNavigateData to NavigateData
37875>>>        Get HasRecord of hoDD to bHasRecord
37876>>>
37876>>>        // let's hide all buttons and then Show the ones we want
37876>>>        WebSet pbRender of oEditBtn to False
37877>>>        WebSet pbRender of oSaveBtn to False
37878>>>        WebSet pbRender of oCancelChangesBtn to False
37879>>>        WebSet pbRender of oDeleteBtn to False
37880>>>
37880>>>        If (NavigateData.bReadOnly) Begin
37882>>>            WebSet pbRender of oEditBtn to True
37883>>>        End
37883>>>>
37883>>>        Else Begin
37884>>>            WebSet pbRender of oSaveBtn to True
37885>>>            WebSet pbRender of oCancelChangesBtn to True
37886>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37887>>>        End
37887>>>>
37887>>>    End_Procedure
