Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebGroup.pkg
Use cWebSpacer.pkg
Use cWebHtmlBox.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebLabel.pkg
Use cWebList.pkg
Use cWebColumn.pkg

Object oDashboard is a cWebView

    Set piMaxWidth to 1600
    
    Set psCaption to "Dashboard"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"
    
    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 24
        
        WebSetResponsive piColumnCount rmMobile to 1
        WebSetResponsive piColumnCount rmTabletPortrait to 16

        // Cabecera principal del dashboard
        Object oDashboardHero is a cWebHtmlBox
            Set piColumnIndex to 0
            Set piColumnSpan to 24
            Set psCSSClass to "DashboardHero"
            Set psHtml to '<section class="ClubOpsHeader"><div class="ClubOpsTitle"><span>Futbol WebApp</span><h1>Centro de gestion deportiva</h1><p>Supervisa competiciones, clubes, plantilla y estructura tecnica desde un panel unico.</p></div><div class="ClubOpsStats"><div><strong>5</strong><span>Ligas</span></div><div><strong>5</strong><span>Equipos</span></div><div><strong>11</strong><span>Jugadores</span></div><div><strong>ST</strong><span>Staff</span></div><div><strong>PX</strong><span>Roles</span></div></div></section>'
            WebSetResponsive piColumnSpan rmMobile to 1
            WebSetResponsive piColumnSpan rmTabletPortrait to 16
        End_Object
    
        // Tarjetas principales para entrar a cada modulo
        Object oTiles_grp is a cWebGroup
            Set piColumnIndex to 0
            Set piColumnSpan to 24
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 24
            Set psCSSClass to "TilesGroup"
            WebSetResponsive piColumnCount rmMobile to 1
            WebSetResponsive piColumnCount rmTabletPortrait to 16
            WebSetResponsive piColumnSpan rmMobile to 1
            WebSetResponsive piColumnSpan rmTabletPortrait to 16

            // Acceso rapido a ligas
            Object oTileLiga is a cWebHtmlBox
               Set pbServerOnClick to True
               Set piColumnSpan to 12
               Set piColumnIndex to 0
               Set psCSSClass to "Tile DashboardTile TileLiga"
               Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="ModuleIcon">LG</div><div class="ModuleCopy"><div class="Tile_Kicker">Competicion</div><div class="Tile_Title">Ligas</div><div class="Tile_Subtitle">Administra competiciones, pais y capacidad de equipos.</div></div><div class="Tile_Action">Abrir</div></div>'
               WebSetResponsive piColumnSpan rmMobile to 1
               WebSetResponsive piColumnIndex rmMobile to 0
               WebSetResponsive piColumnSpan rmTabletPortrait to 8
               WebSetResponsive piColumnIndex rmTabletPortrait to 0
           
               WebRegisterPath ntNavigateForwardCustom oSelectLiga
               
               Procedure OnClick String sId String sParam
                   // Al pulsar la tarjeta abre el listado de ligas
                   Send NavigatePath
               End_Procedure
               
           End_Object

           // Acceso rapido a equipos
           Object oTileEquipo is a cWebHtmlBox
               Set pbServerOnClick to True
               Set piColumnSpan to 12
               Set piColumnIndex to 12
               Set psCSSClass to "Tile DashboardTile TileEquipo"
               Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="ModuleIcon">EQ</div><div class="ModuleCopy"><div class="Tile_Kicker">Clubes</div><div class="Tile_Title">Equipos</div><div class="Tile_Subtitle">Consulta clubes, liga asociada y datos operativos.</div></div><div class="Tile_Action">Abrir</div></div>'
               WebSetResponsive piColumnSpan rmMobile to 1
               WebSetResponsive piColumnIndex rmMobile to 0
               WebSetResponsive piColumnSpan rmTabletPortrait to 8
               WebSetResponsive piColumnIndex rmTabletPortrait to 8
   
               WebRegisterPath ntNavigateForwardCustom oSelectEquipo
               
               Procedure OnClick String sId String sParam
                   // Al pulsar la tarjeta abre el listado de equipos
                   Send NavigatePath
               End_Procedure
               
           End_Object

            // Acceso rapido a entrenadores
            Object oTileEntrenador is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 12
                Set piColumnIndex to 0
                Set psCSSClass to "Tile DashboardTile TileEntrenador"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="ModuleIcon">ST</div><div class="ModuleCopy"><div class="Tile_Kicker">Staff tecnico</div><div class="Tile_Title">Entrenadores</div><div class="Tile_Subtitle">Gestiona perfiles tecnicos y vinculacion con equipos.</div></div><div class="Tile_Action">Abrir</div></div>'
                WebSetResponsive piColumnSpan rmMobile to 1
                WebSetResponsive piColumnIndex rmMobile to 0
                WebSetResponsive piColumnSpan rmTabletPortrait to 8
                WebSetResponsive piColumnIndex rmTabletPortrait to 0
                WebRegisterPath ntNavigateForwardCustom oSelectEntrenador
                
                Procedure OnClick String sId String sParam
                    // Al pulsar la tarjeta abre el listado de entrenadores
                    Send NavigatePath
                End_Procedure
                
            End_Object

            // Acceso rapido a jugadores
            Object oTileJugador is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 12
                Set piColumnIndex to 12
                Set psCSSClass to "Tile DashboardTile TileJugador"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="ModuleIcon">11</div><div class="ModuleCopy"><div class="Tile_Kicker">Plantilla</div><div class="Tile_Title">Jugadores</div><div class="Tile_Subtitle">Mantiene datos de plantilla, nacionalidad y equipo.</div></div><div class="Tile_Action">Abrir</div></div>'
                WebSetResponsive piColumnSpan rmMobile to 1
                WebSetResponsive piColumnIndex rmMobile to 0
                WebSetResponsive piColumnSpan rmTabletPortrait to 8
                WebSetResponsive piColumnIndex rmTabletPortrait to 8
            
                WebRegisterPath ntNavigateForwardCustom oSelectJugador
                
                Procedure OnClick String sId String sParam
                    // Al pulsar la tarjeta abre el listado de jugadores
                    Send NavigatePath
                End_Procedure
                
            End_Object

            // Acceso rapido a posiciones
            Object oTilePosicion is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 12
                Set piColumnIndex to 0
                Set psCSSClass to "Tile DashboardTile TilePosicion"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="ModuleIcon">PX</div><div class="ModuleCopy"><div class="Tile_Kicker">Campo</div><div class="Tile_Title">Posiciones</div><div class="Tile_Subtitle">Define roles tacticos para ordenar la plantilla.</div></div><div class="Tile_Action">Abrir</div></div>'
                WebSetResponsive piColumnSpan rmMobile to 1
                WebSetResponsive piColumnIndex rmMobile to 0
                WebSetResponsive piColumnSpan rmTabletPortrait to 16
                WebSetResponsive piColumnIndex rmTabletPortrait to 0
            
                WebRegisterPath ntNavigateForwardCustom oSelectPosicion
                
                Procedure OnClick String sId String sParam
                    // Al pulsar la tarjeta abre el listado de posiciones
                    Send NavigatePath
                End_Procedure
                
             End_Object
        End_Object
    
    End_Object
    
    Procedure OnBeforeShow
    End_Procedure

End_Object
