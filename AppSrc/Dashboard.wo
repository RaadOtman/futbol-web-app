Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebGroup.pkg
Use cWebSpacer.pkg
Use cWebHtmlBox.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebLabel.pkg
Use cWebList.pkg
Use cWebColumn.pkg

Object oDashboard is a cWebView

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -  
    // Add a DDO Structure 
    //
    // There is no need to synchronize a DD structure on the client so we do
    // not set the Server property or send ADDOStructure. We will simply use
    // DDO's to mine data and generate HTML for our cWebHTMLBox objects.
    // It is the HTML in these objects that is sent to the client each time 
    // this page is shown.
    //
    // Also, it is important for the drill-down Navigation interface that we
    // do not set the Server property to some DDO because this will affect 
    // constraints in the next view that we navigate to.
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 

    Set piMaxWidth to 1600
    
    Set psCaption to "Dashboard"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"
    
    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 24
        
        // - - - - - - - - - - - - - - -
        // Main Panel's Responsive Rules
        // - - - - - - - - - - - - - - -
        WebSetResponsive piColumnCount rmMobile to 1
        WebSetResponsive piColumnCount rmTabletPortrait to 16

        Object oDashboardHero is a cWebHtmlBox
            Set piColumnIndex to 0
            Set piColumnSpan to 24
            Set psCSSClass to "DashboardHero"
            Set psHtml to '<section class="ClubOpsHeader"><div class="ClubOpsTitle"><span>Futbol WebApp</span><h1>Panel de gestion deportiva</h1><p>Operativa central para competiciones, clubes, plantilla y estructura tecnica.</p></div><div class="ClubOpsStats"><div><strong>5</strong><span>Ligas</span></div><div><strong>5</strong><span>Equipos</span></div><div><strong>11</strong><span>Jugadores</span></div><div><strong>ST</strong><span>Staff</span></div><div><strong>PX</strong><span>Posiciones</span></div></div></section>'
            WebSetResponsive piColumnSpan rmMobile to 1
            WebSetResponsive piColumnSpan rmTabletPortrait to 16
        End_Object
    
        Object oTiles_grp is a cWebGroup
            Set piColumnIndex to 0
            Set piColumnSpan to 24
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 24
            Set psCSSClass to "TilesGroup"
            WebSetResponsive piColumnCount rmMobile to 1
            WebSetResponsive piColumnCount rmTabletPortrait to 16
            WebSetResponsive piColumnSpan rmMobile to 1
            WebSetResponsive piColumnSpan rmTabletPortrait to 16

            Object oTileLiga is a cWebHtmlBox
               Set pbServerOnClick to True
               Set piColumnSpan to 12
               Set piColumnIndex to 0
               Set psCSSClass to "Tile DashboardTile TileLiga"
               Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="ModuleIcon">LG</div><div class="ModuleCopy"><div class="Tile_Kicker">Competicion</div><div class="Tile_Title">Ligas</div><div class="Tile_Subtitle">Calendario organizativo y competiciones disponibles.</div></div><div class="Tile_Action">Gestionar</div></div>'
               WebSetResponsive piColumnSpan rmMobile to 1
               WebSetResponsive piColumnIndex rmMobile to 0
               WebSetResponsive piColumnSpan rmTabletPortrait to 8
               WebSetResponsive piColumnIndex rmTabletPortrait to 0
           
               WebRegisterPath ntNavigateForwardCustom oSelectLiga
               
               Procedure OnClick String sId String sParam
                   Send NavigatePath
               End_Procedure
               
           End_Object

           Object oTileEquipo is a cWebHtmlBox
               Set pbServerOnClick to True
               Set piColumnSpan to 12
               Set piColumnIndex to 12
               Set psCSSClass to "Tile DashboardTile TileEquipo"
               Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="ModuleIcon">EQ</div><div class="ModuleCopy"><div class="Tile_Kicker">Clubes</div><div class="Tile_Title">Equipos</div><div class="Tile_Subtitle">Alta y mantenimiento de clubes vinculados a ligas.</div></div><div class="Tile_Action">Gestionar</div></div>'
               WebSetResponsive piColumnSpan rmMobile to 1
               WebSetResponsive piColumnIndex rmMobile to 0
               WebSetResponsive piColumnSpan rmTabletPortrait to 8
               WebSetResponsive piColumnIndex rmTabletPortrait to 8
   
               WebRegisterPath ntNavigateForwardCustom oSelectEquipo
               
               Procedure OnClick String sId String sParam
                   Send NavigatePath
               End_Procedure
               
           End_Object

            Object oTileEntrenador is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 12
                Set piColumnIndex to 0
                Set psCSSClass to "Tile DashboardTile TileEntrenador"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="ModuleIcon">ST</div><div class="ModuleCopy"><div class="Tile_Kicker">Staff tecnico</div><div class="Tile_Title">Entrenadores</div><div class="Tile_Subtitle">Perfiles tecnicos, nacionalidad y equipo asignado.</div></div><div class="Tile_Action">Gestionar</div></div>'
                WebSetResponsive piColumnSpan rmMobile to 1
                WebSetResponsive piColumnIndex rmMobile to 0
                WebSetResponsive piColumnSpan rmTabletPortrait to 8
                WebSetResponsive piColumnIndex rmTabletPortrait to 0
                WebRegisterPath ntNavigateForwardCustom oSelectEntrenador
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
                
            End_Object

            Object oTileJugador is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 12
                Set piColumnIndex to 12
                Set psCSSClass to "Tile DashboardTile TileJugador"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="ModuleIcon">11</div><div class="ModuleCopy"><div class="Tile_Kicker">Plantilla</div><div class="Tile_Title">Jugadores</div><div class="Tile_Subtitle">Control de jugadores y pertenencia deportiva.</div></div><div class="Tile_Action">Gestionar</div></div>'
                WebSetResponsive piColumnSpan rmMobile to 1
                WebSetResponsive piColumnIndex rmMobile to 0
                WebSetResponsive piColumnSpan rmTabletPortrait to 8
                WebSetResponsive piColumnIndex rmTabletPortrait to 8
            
                WebRegisterPath ntNavigateForwardCustom oSelectJugador
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
                
            End_Object

            Object oTilePosicion is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 12
                Set piColumnIndex to 0
                Set psCSSClass to "Tile DashboardTile TilePosicion"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="ModuleIcon">PX</div><div class="ModuleCopy"><div class="Tile_Kicker">Campo</div><div class="Tile_Title">Posiciones</div><div class="Tile_Subtitle">Roles tacticos para clasificar la plantilla.</div></div><div class="Tile_Action">Gestionar</div></div>'
                WebSetResponsive piColumnSpan rmMobile to 1
                WebSetResponsive piColumnIndex rmMobile to 0
                WebSetResponsive piColumnSpan rmTabletPortrait to 16
                WebSetResponsive piColumnIndex rmTabletPortrait to 0
            
                WebRegisterPath ntNavigateForwardCustom oSelectPosicion
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
                
             End_Object
        End_Object
    
    End_Object
    
    Procedure OnBeforeShow
        // Each time this view is shown we will update the appropriate information.
    End_Procedure

End_Object
