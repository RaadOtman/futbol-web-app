// C:\DataFlex Projects\FutbolWebApp\AppSrc\ZoomJugador.wo
// ZoomJugador
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebHtmlBox.pkg
Use cWebButton.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd

Use SelectPosicion.wo

Object oZoomJugador is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Jugador"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024
    Set psCSSClass to "ZoomView ZoomJugadorView"

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        // Relacionamos equipo con liga
        Set DDO_Server to oliga_DD
    End_Object 

    Object ojugador_DD is a cjugadorDataDictionary
        // Relacionamos jugador con equipo
        Set DDO_Server to oequipo_DD
    End_Object 

    Set Main_DD to ojugador_DD
    Set Server  to ojugador_DD


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        Set psCSSClass to "ZoomFormCard"
        WebSetResponsive piColumnCount rmMobile to 4

        Object oZoomHeader is a cWebHtmlBox
            // Header visual personalizado del zoom
            Set piColumnSpan to 12
            Set psCSSClass to "ModuleHeader ZoomHeader"
            Set psHtml to '<section class="ModuleHeaderCard Compact"><div><span class="ModuleEyebrow">Plantilla</span><h1>Detalle de jugador</h1><p>Datos personales, nacionalidad y equipo asociado.</p></div><div class="ModuleHeaderBadge">Registro</div></section>'
            WebSetResponsive piColumnSpan rmMobile to 4
        End_Object

        Object ojugadorNombre is a cWebForm
            Entry_Item jugador.Nombre
            Set piColumnSpan to 6
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nombre"
            WebSetResponsive piColumnSpan rmMobile to 4
        End_Object 

        Object ojugadorApellido is a cWebForm
            Entry_Item jugador.Apellido
            Set piColumnSpan to 6
            Set piColumnIndex to 6
            Set peLabelPosition to lpTop
            Set psLabel to "Apellido"
            WebSetResponsive piColumnSpan rmMobile to 4
        End_Object 

        Object ojugadorNacionalidad is a cWebForm
            Entry_Item jugador.Nacionalidad
            Set piColumnSpan to 8
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nacionalidad"
            WebSetResponsive piColumnSpan rmMobile to 4
        End_Object 

        Object oequipoID is a cWebForm
            Entry_Item equipo.ID
            Set piColumnSpan to 4
            Set piColumnIndex to 8
            Set peLabelPosition to lpTop
            Set psLabel to "Equipo"
            Set pbPromptButton to True
            WebSetResponsive piColumnSpan rmMobile to 4


            WebRegisterPath ntNavigateForward oSelectEquipo

            Procedure OnPrompt
                // Abre el selector de equipos
                Send NavigatePath
            End_Procedure
        End_Object

        Object oVerPosicionesBtn is a cWebButton
            // Este boton abre las posiciones del jugador
            Set psCaption to "Posiciones del jugador"
            Set piColumnSpan to 4
            Set piColumnIndex to 0
            Set psCSSClass to "InlineActionButton"

            WebRegisterPath ntNavigateForwardCustom oSelectPosicion

            Procedure OnClick
                // Navegacion manual hacia posiciones
                Send NavigatePath
            End_Procedure
        End_Object
    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Guardar"

            Procedure OnClick
                Send Request_Save
            End_Procedure

        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Editar"
            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure

        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Eliminar"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure

        End_Object 

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Descartar cambios"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send RefreshRecord
            End_Procedure

        End_Object 

        Object oVerPosicionesBtn is a cWebMenuItem
            // Mismo acceso desde el menu de acciones
            Set psCSSClass to "WebPromptMenuItem"
            Set psCaption to "Ver posiciones"
            Set peActionDisplay to adMenu

            WebRegisterPath ntNavigateForwardCustom oSelectPosicion

            Procedure OnClick
                // Abre SelectPosicion desde el menu
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                String sJugadorID

                // Pasamos el jugador actual a la navegacion manual
                Get Field_Current_Value of ojugador_DD Field jugador.ID to sJugadorID
                Get NamedValueAdd NavigateData.NamedValues "JugadorID" sJugadorID to NavigateData.NamedValues
                Get NamedValueAdd NavigateData.NamedValues "JugadorRowID" (SerializeRowID(CurrentRowId(ojugador_DD))) to NavigateData.NamedValues
                Move True to NavigateData.bReadOnly
            End_Procedure

        End_Object
    End_Object

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        // Muestra solo las acciones que tocan segun el modo
        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        // Al guardar vuelve a la vista anterior
        Send NavigateClose Self
    End_Procedure

    Procedure OnViewDeleted Handle hoDDO
        // Al eliminar vuelve a la vista anterior
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        Case Begin
            Case (NavigateData.eNavigateType = nfFromMain)
                // Entrada desde un listado principal
                Case Break

            Case (NavigateData.eNavigateType = nfFromParent)
                // Entrada desde una vista padre
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // Entrada desde una vista hija
                Case Break

            Case Else // nfUndefined

        Case End

        Send SetActionButtons

    End_Procedure

End_Object 
